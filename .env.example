# ==============================================================================
# ApproveHub Production Environment Variables Configuration Template (.env)
# ==============================================================================

# Core Flask Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=approvehub-super-secret-key-production-2026-vit

# Database Configuration (Leave blank for local SQLite or provide PostgreSQL URL)
# Example for Neon/Supabase/Render Postgres: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Port & Host binding
PORT=5000
HOST=0.0.0.0

# Institutional Google OAuth 2.0 Credentials (Optional - for Google SSO)
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Transactional Email Dispatch Configuration
# For Gmail App Password: smtp.gmail.com, port 587, your email, and 16-character App Password
# For SendGrid: smtp.sendgrid.net, port 587, user "apikey", password "<SENDGRID_API_KEY>"
# For Resend: smtp.resend.com, port 587, user "resend", password "<RESEND_API_KEY>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=notifications@approvehub.edu
SMTP_TLS=true

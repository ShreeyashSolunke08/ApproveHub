# ==============================================================================
# ApproveHub — .gitignore
# ==============================================================================

# Python byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/

# Environment configuration
.env

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Database files (development only — production uses PostgreSQL)
*.db
*.sqlite
*.sqlite3

# Upload directories (user-generated content — not versioned)
uploads/docs/*
uploads/final/*
uploads/assets/*
uploads/qr/*
!uploads/docs/.gitkeep
!uploads/final/.gitkeep
!uploads/assets/.gitkeep
!uploads/qr/.gitkeep

# Android build artifacts (generated by CI/CD)
android_build_artifact/
android/

# Node.js dependencies (Capacitor build only)
node_modules/

# Distribution & build artifacts
dist/
build/
*.egg-info/
